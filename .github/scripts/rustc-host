#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# A RUSTC_WRAPPER for musl builds: host artifacts (build scripts, proc macros) are built without
# --target and get linked dynamically so bindgen can load libclang; the release binary stays static.

case " $* " in
  *" --target "* | *" --target="*) exec "$@" ;;
  *) exec "$@" -C target-feature=-crt-static ;;
esac
